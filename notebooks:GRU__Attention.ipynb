"""**مدل GRU**"""

class AttentionLayer(nn.Module):
    def __init__(self, hidden_dim):
        super(AttentionLayer, self).__init__()
        self.attn_weights = nn.Linear(hidden_dim * 2, 1, bias=False)

    def forward(self, hidden_states):
        attn_scores = self.attn_weights(hidden_states).squeeze(-1)
        attn_weights = torch.softmax(attn_scores, dim=1).unsqueeze(-1)
        weighted_output = hidden_states * attn_weights
        return weighted_output, attn_weights

class MeterPredictionGRUWithAttention(nn.Module):
    def __init__(self, encoder_model_name, hidden_dim, num_classes):
        super(MeterPredictionGRUWithAttention, self).__init__()

        # ParsBERT encoder for token embeddings
        self.encoder = AutoModel.from_pretrained(encoder_model_name)
        self.gru = nn.GRU(self.encoder.config.hidden_size, hidden_dim, bidirectional=True, batch_first=True)
        self.attention = AttentionLayer(hidden_dim)

        # Decoder Linear layer for each token
        self.decoder = nn.Linear(hidden_dim * 2, num_classes)

    def forward(self, input_ids, attention_mask):

        encoder_outputs = self.encoder(input_ids=input_ids, attention_mask=attention_mask)
        embeddings = encoder_outputs.last_hidden_state
        gru_output, _ = self.gru(embeddings)

        attn_output, attn_weights = self.attention(gru_output)

        logits = self.decoder(attn_output)

        return logits, attn_weights

