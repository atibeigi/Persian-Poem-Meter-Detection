def beam_search(logits, beam_size, max_seq_length):
    beams = [([], 0.0)]
    for step in range(max_seq_length):
        new_beams = []
        for seq, score in beams:
            probs = torch.softmax(logits[step], dim=-1).cpu().numpy()
            top_k = probs.argsort()[-beam_size:][::-1]
            for idx in top_k:
                new_seq = seq + [idx]
                new_score = score + torch.log(torch.tensor(probs[idx]))
                new_beams.append((new_seq, new_score))

        # نگهداری توالی بیم سایز برتر
        new_beams = sorted(new_beams, key=lambda x: x[1], reverse=True)[:beam_size]

        print(f"Step {step+1} Top sequences and scores:")
        for s, sc in new_beams:
            print(f"  Sequence: {s}, Score: {sc.item()}")

        beams = new_beams
    return beams[0][0]


# حلقه پیش‌بینی با Beam Search
